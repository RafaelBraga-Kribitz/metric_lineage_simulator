// Generated by Metric Driver-Tree Studio from model 'dtc_ecommerce'.
// Table: kpi_inputs[period, metric_id, value] (long format, one row per period and input).
// Inputs: counts SUM; rates and per-unit values AVERAGE (unweighted: read them per period).
// Total-type identity parents (count/EUR, no divisor) iterate periods (SUMX) so multi-period totals stay exact.
// Modeled / hypothesized edges are assumptions: they are NOT measures.

// Sessions from first-time visitors. (Neue Sitzungen)
New Sessions = CALCULATE(SUM('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "new_sessions")

// Share of product viewers who add an item to cart. (Warenkorbrate)
Add to Cart Rate = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "add_to_cart_rate")

// Share of cart adds that begin checkout. (Checkout-Startrate)
Checkout Start Rate = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "checkout_start_rate")

// Share of checkout starts that complete purchase. (Kaufabschlussrate)
Purchase Completion Rate = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "purchase_completion_rate")

// Revenue per order. (Warenkorbwert (Ø Bestellwert))
Average Order Value = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "average_order_value")

// Variable cost per fulfilled order (COGS + ship + payment). (Variable Kosten je Bestellung)
Cost per Order = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "cost_per_order")

// Share of new sessions yielding an email opt-in. (E-Mail-Erfassungsrate)
Email Capture Rate = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "email_capture_rate")

// Median page load duration in seconds. (Ladezeit (s))
Page Load Speed (s) = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "page_load_speed")

// Share of customers enrolled in the loyalty program. WARNING: high LTV correlation is likely selection, not causation. Heavy buyers self-select into programs; the program does not manufacture heavy buyers. Requires a randomized enrollment experiment to isolate lift. (Kundenbindungsquote (Treueprogramm))
Loyalty Membership Rate = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "loyalty_membership")

// Sessions from known visitors. Driven (illustratively) by email capture rate. (Wiederkehrende Sitzungen)
Returning Sessions = CALCULATE(SUM('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "returning_sessions")

// Share of sessions viewing at least one product page. (Produktansichtsrate)
Product View Rate = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "product_view_rate")

// Long-run contribution per customer (informational; not in current period identity). (Kundenwert (CLV))
Customer LTV = CALCULATE(AVERAGE('kpi_inputs'[value]), 'kpi_inputs'[metric_id] = "customer_ltv")

// New sessions plus returning sessions over the period. (Sitzungen)
Sessions = SUMX(VALUES('kpi_inputs'[period]), [New Sessions] + [Returning Sessions])

// Orders divided by sessions; product of the four funnel-stage rates. (Konversionsrate)
Conversion Rate = [Product View Rate] * [Add to Cart Rate] * [Checkout Start Rate] * [Purchase Completion Rate]

// Sessions times conversion rate. (Anzahl Bestellungen)
Orders = SUMX(VALUES('kpi_inputs'[period]), [Sessions] * [Conversion Rate])

// Orders times average order value. (Nettoumsatz)
Net Revenue = SUMX(VALUES('kpi_inputs'[period]), [Orders] * [Average Order Value])

// Orders times unit variable cost (COGS + fulfillment + payment). (Variable Kosten)
Variable Costs = SUMX(VALUES('kpi_inputs'[period]), [Orders] * [Cost per Order])

// Net revenue minus variable costs over the period. (Deckungsbeitrag)
Contribution Profit = SUMX(VALUES('kpi_inputs'[period]), [Net Revenue] - [Variable Costs])
